 "tp": {
  "formation": "Titre pro EEB / CAP MELEC",
  "duree": "Journée (7 h)",
  "date": "",
  "edited": true,
  "objectif": "<ul><li>Lire et exploiter un dossier technique (plans architectural et d’implantation, schéma du tableau, liste du matériel).</li><li>Poser les canalisations et l’appareillage, réaliser les raccordements conformément aux plans et à la NF C 15-100.</li><li>Effectuer les vérifications avant la mise en service et expliquer le fonctionnement.</li></ul>",
  "situation": "<p><b>Espace de travail 2 – Parties communes de l’immeuble.</b> À partir de la boîte étanche proche de l’espace 2, qui contient le circuit prises C3, le circuit d’éclairage C2 et le circuit de commande « minuterie » (retours lampe et BP), ainsi que la boîte de dérivation pour moulure 4 (déport de platine de rue), vous réalisez la partie éclairage et force : 2 points d’éclairage (L1, L2), 3 points de commande (A1 à A3), 1 prise (A4), 2 boîtes de dérivation (B1, B2) et un combiné interphone 1.</p>",
  "travail": "<ol><li>L1 et L2 sont commandées par les BP A1 à A3 raccordés sur le <b>circuit minuterie C2</b> (en attente dans la boîte étanche).</li><li>La prise A4 est raccordée sur le <b>circuit PC C3</b>.</li><li>Installer et raccorder le <b>combiné 1</b> sur le déport de platine de rue en attente dans la boîte 4 (moulure M1).</li><li>Installer et raccorder les boîtes de dérivation B1 et B2.</li><li>Poser les conduits IRL C01 (Ø25), C02 (Ø16) et la moulure M1.</li></ol>",
  "contraintes": "<p class=\"warn\"><b>Sécurité :</b> travail exclusivement hors tension (AGCP consigné). Le raccordement à la source et la mise en service se font uniquement en présence du formateur (jury). Port des EPI obligatoire.</p><ul><li>Conduits IRL fixés avec les colliers adaptés, alignés et d’aplomb.</li><li>Le raccordement des câbles d’alimentation (éclairage, PC) à la boîte étanche ne se fait qu’à la mise en service, en présence du formateur.</li><li>Documents à remplir : attestation de consignation et autorisation de travail.</li></ul>",
  "materiel": "<table class=\"t\"><tr><th>Repère</th><th>Désignation</th><th>Qté</th><th>Observations</th></tr><tr><td>B1-B2</td><td>Boîte de dérivation 7 entrées</td><td>2</td><td>Conduits Ø16, 20, 25</td></tr><tr><td>L1-L2</td><td>Patère</td><td>2</td><td></td></tr><tr><td>A1-A2-A3</td><td>Bouton poussoir (support saillie)</td><td>3</td><td></td></tr><tr><td>A4</td><td>PC 2P+T (support saillie)</td><td>1</td><td></td></tr><tr><td>C01</td><td>Conduit IRL Ø25 + fixations</td><td>≈ 2 ml</td><td>Selon agencement</td></tr><tr><td>C02</td><td>Conduit IRL Ø16 + fixations</td><td>≈ 3 ml</td><td>Selon agencement</td></tr><tr><td>—</td><td>Câble U1000 R2V 5G1,5</td><td>3 ml</td><td></td></tr><tr><td>—</td><td>Câble U1000 R2V 3G2,5</td><td>3 ml</td><td></td></tr><tr><td>—</td><td>Câble U1000 R2V 3G1,5</td><td>5 ml</td><td></td></tr><tr><td>1</td><td>Combiné intérieur (interphone)</td><td>1</td><td>Compatible contrôle d’accès</td></tr><tr><td>—</td><td>SYT 3P 6/10</td><td>2 ml</td><td></td></tr><tr><td>M1</td><td>Moulure 20 × 12,5</td><td>2 ml</td><td>Selon agencement</td></tr></table>",
  "evaluation": "<table class=\"t\"><tr><th>Critère</th><th class=\"n\">Barème</th><th class=\"n\">Note</th></tr>\n<tr><td>Respect des normes (NF C 15-100, sections, protections, couleurs)</td><td class=\"n\">/ 4</td><td></td></tr>\n<tr><td>Respect du câblage et des repères (conformité aux plans)</td><td class=\"n\">/ 4</td><td></td></tr>\n<tr><td>Gestion de la consommation des fils et du matériel</td><td class=\"n\">/ 4</td><td></td></tr>\n<tr><td>Présentation globale du travail (pose, alignements, finitions)</td><td class=\"n\">/ 4</td><td></td></tr>\n<tr><td>Explication orale du fonctionnement</td><td class=\"n\">/ 4</td><td></td></tr>\n<tr><th>Total</th><th class=\"n\">/ 20</th><th></th></tr></table>",
